# Reference for an isolated test VM only. Generate a private judge0.conf with
# manage_config.py; never commit it. Limits require independent verification.
JUDGE0_TELEMETRY_ENABLE=false
ENABLE_WAIT_RESULT=true
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_BATCHED_SUBMISSIONS=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
ENABLE_SUBMISSION_DELETE=false
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=GENERATE_AUTH_TOKEN
REDIS_HOST=redis
REDIS_PASSWORD=GENERATE_REDIS_PASSWORD
POSTGRES_HOST=db
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
SECRET_KEY_BASE=GENERATE_SECRET_KEY
COUNT=1
MAX_QUEUE_SIZE=10
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=2
CPU_EXTRA_TIME=0.5
MAX_CPU_EXTRA_TIME=0.5
WALL_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=5
MEMORY_LIMIT=128000
MAX_MEMORY_LIMIT=128000
STACK_LIMIT=64000
MAX_STACK_LIMIT=64000
MAX_PROCESSES_AND_OR_THREADS=32
MAX_MAX_PROCESSES_AND_OR_THREADS=32
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=1024
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false
